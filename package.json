{
  "name": "sutinki",
  "version": "0.1.0",
  "private": true,
  "description": "Сутінки — personal offline-first Ukrainian study app (monorepo root)",
  "scripts": {
    "pipeline": "tsx packages/pipeline/src/cli.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "theme:grep": "pnpm --filter sutinki-mobile theme:grep"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@11.22.0"
}
